{
  "name": "gatekeeper-usage",
  "main": ".wrangler/validate/src/usage.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserAccount", "UsageGatekeeperImpl"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

  // Deployment configuration (set as Worker variables/secrets, not committed here):
  //   BASE_URL                  Public URL of this Worker, e.g. "https://usage-gk.example.com".
  //                             Must be covered by a Cloudflare Access application.
  //   USAGE_ACCESS_ISS          Access team origin, e.g. "https://acme.cloudflareaccess.com".
  //   USAGE_ACCESS_AUD          AUD tag of the Access application protecting BASE_URL.
  //   USAGE_ADMINS              Comma-separated administrator emails.
  //   USAGE_GATEWAY_ACCOUNT_ID  Account that owns the deployment's AI Gateway.
  //   USAGE_GATEWAY_NAME        The AI Gateway name (same as the Workshop's CF_AI_GATEWAY).
  //   USAGE_GATEWAY_API_TOKEN   Secret: an AI Gateway Read token for that account.
}
